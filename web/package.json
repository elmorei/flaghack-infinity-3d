{
  "name": "flaghack-infinity",
  "private": true,
  "version": "0.1.2-iteration.1",
  "type": "module",
  "description": "Survey Flags: a 3D 1v1v1v1 vexillomantic action-strategy game built on an aperiodic Ley Lattice.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "vite build --ssr server/main.ts",
    "host": "vite build --logLevel warn && vite build --ssr server/main.ts --logLevel warn && node --enable-source-maps dist-server/main.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:sim": "bun bench/sim-eval.ts",
    "desktop:build": "npm run build && node desktop/build-metadata.cjs",
    "desktop:test": "node --test desktop/*.test.cjs",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:package": "npm run desktop:build && electron-builder --config electron-builder.cjs --win --x64 --publish never",
    "build:pages": "npm run build && node scripts/write-pages-metadata.cjs",
    "host-app:build": "tsc --noEmit && vite build --config vite.host.config.ts",
    "host-app:test": "node --test host-desktop/*.test.cjs scripts/*.test.cjs",
    "host-app:dev": "npm run host-app:build && electron host-desktop/main.cjs",
    "host-app:package": "npm run host-app:build && node scripts/fetch-cloudflared.cjs && electron-builder --config electron-host-builder.cjs --win --x64 --publish never"
  },
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@fontsource/stardos-stencil": "^5.3.0",
    "electron-updater": "6.8.9",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "main": "desktop/main.cjs"
}
